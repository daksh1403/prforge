# Copy to .env and fill in. Only ONE provider is required.

# Provider: anthropic | openai | ollama
PRFORGE_LLM_PROVIDER=anthropic

# Anthropic (recommended for coding)
ANTHROPIC_API_KEY=sk-ant-...
PRFORGE_MODEL=claude-sonnet-4-5-20250929

# OpenAI
# PRFORGE_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# PRFORGE_MODEL=gpt-4o

# Ollama (local, free) — run `ollama pull qwen2.5-coder:7b`
# PRFORGE_LLM_PROVIDER=ollama
# PRFORGE_OLLAMA_BASE_URL=http://localhost:11434/v1
# PRFORGE_MODEL=qwen2.5-coder:7b

# Agent behaviour
PRFORGE_MAX_ITERATIONS=3
PRFORGE_SANDBOX_IMAGE=prforge-sandbox:latest
PRFORGE_AUTO_APPROVE=false
